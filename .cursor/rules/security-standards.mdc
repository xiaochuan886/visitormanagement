## 数据验证与清理

### 输入验证标准
```python
# ✅ 正确示例 - 严格的数据验证
class VisitorCreateRequest(BaseModel):
    name: str = Field(..., min_length=2, max_length=50, regex=r"^[\u4e00-\u9fa5a-zA-Z\s]+$")
    phone: str = Field(..., regex=r"^1[3-9]\d{9}$")  # 中国手机号格式
    email: EmailStr = Field(...)  # 使用EmailStr确保邮箱格式
    company: str = Field(..., min_length=2, max_length=100)
    id_number: str = Field(..., regex=r"^\d{15}|\d{18}$")  # 身份证号格式
    license_plate: Optional[str] = Field(None, regex=r"^[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼使领A-Z]{1}[A-Z]{1}[A-Z0-9]{4}[A-Z0-9挂学警港澳]{1}$")
    
    @validator('name')
    def validate_name(cls, v):
        # 清理输入，防止XSS攻击
        return html.escape(v.strip())
    
    @validator('company')
    def validate_company(cls, v):
        return html.escape(v.strip())

# ❌ 错误示例 - 缺少验证
class UnsafeVisitorRequest(BaseModel):
    name: str  # 没有长度限制和格式验证
    phone: str  # 没有格式验证
    email: str  # 没有邮箱格式验证
    # 存在注入攻击风险
```

### SQL注入防护
```python
# ✅ 正确示例 - 使用ORM参数化查询
async def get_visitors_by_name(db: AsyncSession, name: str, tenant_id: str):
    result = await db.execute(
        select(Visitor).where(
            and_(
                Visitor.name.like(f"%{name}%"),  # SQLAlchemy自动转义
                Visitor.tenant_id == tenant_id
            )
        )
    )
    return result.scalars().all()

# ❌ 错误示例 - SQL注入风险
async def unsafe_query(db: AsyncSession, name: str):
    # 违反：直接字符串拼接，存在SQL注入风险
    query = f"SELECT * FROM visitors WHERE name LIKE '%{name}%'"
    result = await db.execute(text(query))
    return result.fetchall()
```

## 密码安全

### 密码哈希标准
```python
# ✅ 正确示例 - 安全的密码处理
from passlib.context import CryptContext

pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

class PasswordHandler:
    @staticmethod
    def hash_password(password: str) -> str:
        """使用bcrypt哈希密码"""
        return pwd_context.hash(password)
    
    @staticmethod
    def verify_password(plain_password: str, hashed_password: str) -> bool:
        """验证密码"""
        return pwd_context.verify(plain_password, hashed_password)

# 密码强度要求
class PasswordValidator:
    @staticmethod
    def validate_strength(password: str) -> bool:
        """验证密码强度"""
        if len(password) < 8:
            raise ValueError("密码长度不能少于8位")
        
        if not re.search(r"[A-Z]", password):
            raise ValueError("密码必须包含大写字母")
        
        if not re.search(r"[a-z]", password):
            raise ValueError("密码必须包含小写字母")
        
        if not re.search(r"[0-9]", password):
            raise ValueError("密码必须包含数字")
        
        if not re.search(r"[!@#$%^&*(),.?\":{}|<>]", password):
            raise ValueError("密码必须包含特殊字符")
        
        return True

# ❌ 错误示例 - 不安全的密码处理
def unsafe_password_hash(password: str) -> str:
    # 违反：使用MD5或SHA1，没有盐值
    return hashlib.md5(password.encode()).hexdigest()
```

## 安全配置

### CORS配置
```python
# ✅ 正确示例 - 安全的CORS配置
from fastapi.middleware.cors import CORSMiddleware

app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.ALLOWED_HOSTS,  # 明确指定允许的域名
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE"],  # 明确指定允许的方法
    allow_headers=["Authorization", "Content-Type"],  # 明确指定允许的头部
    max_age=600  # 预检请求缓存时间
)

# ❌ 错误示例 - 不安全的CORS配置
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # 违反：允许所有域名
    allow_methods=["*"],  # 违反：允许所有方法
    allow_headers=["*"]   # 违反：允许所有头部
)
```

### 环境变量安全
```python
# ✅ 正确示例 - 安全的配置管理
class Settings(BaseSettings):
    SECRET_KEY: str = Field(..., min_length=32)  # 强制最小长度
    DATABASE_URL: str = Field(..., env="DATABASE_URL")
    REDIS_URL: str = Field(..., env="REDIS_URL")
    
    # 敏感配置禁止默认值
    MAIL_PASSWORD: str = Field(..., env="MAIL_PASSWORD")
    
    # 开发环境标识
    DEBUG: bool = Field(False, env="DEBUG")
    
    class Config:
        env_file = ".env"
        case_sensitive = True

# ❌ 错误示例 - 不安全的配置
SECRET_KEY = "weak_key_123"  # 违反：硬编码敏感信息
DATABASE_URL = "postgresql://admin:password@localhost/db"  # 违反：明文密码
```

## 日志与审计

### 安全事件记录
```python
# ✅ 正确示例 - 安全审计日志
import logging

security_logger = logging.getLogger("security")

class SecurityAuditService:
    @staticmethod
    async def log_login_attempt(username: str, ip_address: str, success: bool):
        event_type = "LOGIN_SUCCESS" if success else "LOGIN_FAILED"
        security_logger.info(
            f"{event_type} - User: {username}, IP: {ip_address}, Time: {datetime.utcnow()}"
        )
    
    @staticmethod
    async def log_permission_denied(user_id: str, resource: str, action: str):
        security_logger.warning(
            f"PERMISSION_DENIED - User: {user_id}, Resource: {resource}, Action: {action}"
        )
    
    @staticmethod
    async def log_data_access(user_id: str, tenant_id: str, resource: str):
        security_logger.info(
            f"DATA_ACCESS - User: {user_id}, Tenant: {tenant_id}, Resource: {resource}"
        )
```

## 检查清单

### 认证安全检查
- [ ] JWT令牌是否包含所有必需字段？
- [ ] 令牌过期时间是否合理？
- [ ] 是否实施了租户隔离？
- [ ] 刷新令牌机制是否安全？
- [ ] 登录失败是否有限制机制？

### 权限控制检查
- [ ] 所有API端点是否有权限检查？
- [ ] 权限粒度是否足够细致？
- [ ] 角色权限映射是否正确？
- [ ] 数据查询是否包含租户过滤？

### 数据验证检查
- [ ] 所有输入是否经过验证？
- [ ] 是否防护了SQL注入攻击？
- [ ] 是否防护了XSS攻击？
- [ ] 敏感数据是否正确脱敏？

### 配置安全检查
- [ ] 敏感配置是否使用环境变量？
- [ ] CORS配置是否足够严格？
- [ ] HTTPS是否强制启用？
- [ ] 错误信息是否泄露敏感信息？

### 密码安全检查
- [ ] 密码是否使用强哈希算法？
- [ ] 是否实施了密码强度要求？
- [ ] 是否有密码重置机制？
- [ ] 是否记录了安全事件？

# 安全开发标准 - Security Standards

## 规则概述
本规则确保访客管理系统的安全开发实践，涵盖JWT认证、数据验证、权限控制和安全配置。适用于所有涉及用户认证、数据处理和API安全的开发任务。

## 认证与授权架构

### JWT令牌管理
**核心实现**: [auth.py](mdc:backend_service/app/api/routes/auth.py) - 认证路由
**依赖管理**: [dependencies](mdc:backend_service/app/api/dependencies/) - 认证依赖注入

#### 令牌结构标准
```python
# JWT Payload 必需字段
{
    "sub": "user_id",           # 用户ID (必需)
    "tenant_id": "company_a",   # 租户ID (必需)
    "username": "admin",        # 用户名 (必需)
    "roles": ["admin", "user"], # 角色列表 (必需)
    "permissions": [            # 权限列表 (必需)
        "visitor:read",
        "visitor:write",
        "employee:read"
    ],
    "exp": 1640995200,         # 过期时间 (必需)
    "iat": 1640908800,         # 签发时间 (必需)
    "type": "access"           # 令牌类型 (access/refresh)
}
```

#### 令牌生成规范
```python
# ✅ 正确示例 - 安全的令牌生成
class JWTHandler:
    def create_access_token(
        self, 
        user_id: str, 
        username: str,
        tenant_id: str,
        roles: List[str],
        permissions: List[str]
    ) -> str:
        payload = {
            "sub": user_id,
            "tenant_id": tenant_id,
            "username": username,
            "roles": roles,
            "permissions": permissions,
            "exp": datetime.utcnow() + timedelta(minutes=settings.ACCESS_TOKEN_EXPIRE_MINUTES),
            "iat": datetime.utcnow(),
            "type": "access"
        }
        return jwt.encode(payload, settings.SECRET_KEY, algorithm="HS256")
    
    def create_refresh_token(self, user_id: str, tenant_id: str) -> str:
        payload = {
            "sub": user_id,
            "tenant_id": tenant_id,
            "exp": datetime.utcnow() + timedelta(days=7),
            "iat": datetime.utcnow(),
            "type": "refresh"
        }
        return jwt.encode(payload, settings.SECRET_KEY, algorithm="HS256")

# ❌ 错误示例 - 不安全的令牌
def create_token(user_id: str) -> str:
    # 违反：缺少必要字段、过期时间、租户隔离
    payload = {"user_id": user_id}
    return jwt.encode(payload, "weak_key", algorithm="HS256")
```

### 多租户安全隔离

#### 租户上下文注入
```python
# ✅ 正确示例 - 安全的租户注入
async def get_current_tenant(
    token: str = Depends(oauth2_scheme),
    jwt_handler: JWTHandler = Depends(get_jwt_handler)
) -> str:
    """获取当前请求的租户ID"""
    try:
        payload = jwt_handler.decode_token(token)
        tenant_id = payload.get("tenant_id")
        if not tenant_id:
            raise HTTPException(401, "令牌缺少租户信息")
        return tenant_id
    except JWTError:
        raise HTTPException(401, "无效的认证令牌")

# ✅ 正确示例 - 数据查询自动注入租户过滤
async def get_visitors(
    tenant_id: str = Depends(get_current_tenant),
    db: AsyncSession = Depends(get_database)
) -> List[VisitorResponse]:
    result = await db.execute(
        select(Visitor).where(Visitor.tenant_id == tenant_id)  # 强制租户过滤
    )
    return [VisitorResponse.from_model(v) for v in result.scalars().all()]

# ❌ 错误示例 - 缺少租户隔离
async def get_visitors(db: AsyncSession = Depends(get_database)):
    # 违反：没有租户过滤，存在数据泄露风险
    result = await db.execute(select(Visitor))
    return result.scalars().all()
```

## 权限控制系统

### 基于角色的访问控制 (RBAC)
```python
# ✅ 正确示例 - 权限检查装饰器
def require_permission(permission: str):
    def decorator(func):
        async def wrapper(*args, **kwargs):
            # 从当前用户上下文获取权限
            current_user = kwargs.get('current_user')
            if not current_user or permission not in current_user.permissions:
                raise HTTPException(403, f"缺少权限: {permission}")
            return await func(*args, **kwargs)
        return wrapper
    return decorator

# ✅ 正确示例 - API权限控制
@router.post("/visitors")
@require_permission("visitor:create")
async def create_visitor(
    visitor_data: VisitorCreateRequest,
    current_user: UserContext = Depends(get_current_user),
    tenant_id: str = Depends(get_current_tenant)
) -> VisitorResponse:
    # 权限已验证，安全执行业务逻辑
    pass

# ❌ 错误示例 - 缺少权限检查
@router.delete("/visitors/{visitor_id}")
async def delete_visitor(visitor_id: int):
    # 违反：删除操作没有权限检查
    pass
```


    tenant_id: str
    reason: str
    deactivated_by: Optional[str] = None
    occurred_at: datetime = field(default_factory=datetime.utcnow)

# 事件处理器示例
class SecurityEventHandler:
    def __init__(self, audit_service: AuditService):
        self._audit_service = audit_service
    
    async def handle_user_logged_in(self, event: UserLoggedInEvent):
        """处理用户登录事件"""
        await self._audit_service.log_security_event(
            event_type="USER_LOGIN",
            user_id=event.user_id,
            tenant_id=event.tenant_id,
            details={
                "login_time": event.login_time.isoformat(),
                "ip_address": event.ip_address,
                "user_agent": event.user_agent
            }
        )
    
    async def handle_user_locked(self, event: UserLockedEvent):
        """处理用户锁定事件"""
        await self._audit_service.log_security_event(
            event_type="USER_LOCKED",
            user_id=event.user_id,
            tenant_id=event.tenant_id,
            details={
                "locked_until": event.locked_until.isoformat(),
                "reason": event.reason
            }
        )
        
        # 发送安全告警
        await self._send_security_alert(event)

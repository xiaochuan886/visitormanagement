## 多租户认证架构

### 租户上下文管理
```python
# ✅ 正确示例 - 租户上下文管理
@dataclass(frozen=True)
class TenantContext:
    """租户上下文"""
    tenant_id: str
    tenant_name: str
    is_active: bool
    created_at: datetime
    settings: Dict[str, Any] = field(default_factory=dict)

@dataclass(frozen=True)
class UserContext:
    """用户上下文"""
    user_id: str
    username: str
    email: str
    roles: List[str]
    permissions: List[str]
    tenant: TenantContext
    last_login: Optional[datetime] = None

class AuthenticationService:
    def __init__(
        self,
        user_repo: UserRepository,
        tenant_repo: TenantRepository,
        jwt_handler: JWTHandler,
        password_handler: PasswordHandler
    ):
        self._user_repo = user_repo
        self._tenant_repo = tenant_repo
        self._jwt_handler = jwt_handler
        self._password_handler = password_handler
    
    async def authenticate(self, username: str, password: str, tenant_id: str) -> AuthResult:
        """多租户用户认证"""
        # 1. 验证租户
        tenant = await self._tenant_repo.get_by_id(tenant_id)
        if not tenant or not tenant.is_active:
            raise TenantInactiveException("租户不存在或已停用")
        
        # 2. 获取用户（租户隔离）
        user = await self._user_repo.get_by_username(username, tenant_id)
        if not user:
            raise InvalidCredentialsException("用户名或密码错误")
        
        # 3. 执行认证
        user.authenticate(password, self._password_handler)
        
        # 4. 获取用户权限
        user_permissions = await self._get_user_permissions(user)
        
        # 5. 生成令牌
        access_token = self._jwt_handler.create_access_token(
            user_id=str(user.id),
            username=user.username,
            tenant_id=tenant_id,
            roles=user.roles,
            permissions=user_permissions
        )
        
        refresh_token = self._jwt_handler.create_refresh_token(
            user_id=str(user.id),
            tenant_id=tenant_id
        )
        
        # 6. 更新最后登录时间
        await self._user_repo.save(user)
        
        return AuthResult(
            access_token=access_token,
            refresh_token=refresh_token,
            user_context=UserContext(
                user_id=str(user.id),
                username=user.username,
                email=user.email,
                roles=user.roles,
                permissions=user_permissions,
                tenant=TenantContext(
                    tenant_id=tenant.id,
                    tenant_name=tenant.name,
                    is_active=tenant.is_active,
                    created_at=tenant.created_at,
                    settings=tenant.settings
                ),
                last_login=user.last_login
            )
        )
    
    async def refresh_token(self, refresh_token: str) -> AuthResult:
        """刷新访问令牌"""
        try:
            payload = self._jwt_handler.decode_token(refresh_token)
            
            if payload.get("type") != "refresh":
                raise InvalidTokenException("无效的刷新令牌")
            
            user_id = payload.get("sub")
            tenant_id = payload.get("tenant_id")
            
            if not user_id or not tenant_id:
                raise InvalidTokenException("令牌缺少必要信息")
            
            # 重新获取用户信息（确保最新权限）
            user = await self._user_repo.get_by_id(int(user_id), tenant_id)
            if not user or not user.is_active:
                raise UserInactiveException("用户不存在或已停用")
            
            # 获取最新权限
            user_permissions = await self._get_user_permissions(user)
            
            # 生成新的访问令牌
            new_access_token = self._jwt_handler.create_access_token(
                user_id=user_id,
                username=user.username,
                tenant_id=tenant_id,
                roles=user.roles,
                permissions=user_permissions
            )
            
            return AuthResult(
                access_token=new_access_token,
                refresh_token=refresh_token,  # 刷新令牌保持不变
                user_context=UserContext(
                    user_id=user_id,
                    username=user.username,
                    email=user.email,
                    roles=user.roles,
                    permissions=user_permissions,
                    tenant=await self._get_tenant_context(tenant_id),
                    last_login=user.last_login
                )
            )
            
        except JWTError as e:
            raise InvalidTokenException(f"令牌验证失败: {str(e)}")
    
    async def _get_user_permissions(self, user: User) -> List[str]:
        """获取用户的所有权限"""
        all_permissions = set()
        
        for role_name in user.roles:
            # 优先查找系统角色
            if role_name in SYSTEM_ROLES:
                role = SYSTEM_ROLES[role_name]
            else:
                # 查找租户自定义角色
                role = await self._role_repo.get_by_name(role_name, user.tenant_id)
            
            if role:
                all_permissions.update(role.permissions)
        
        return list(all_permissions)
```

### 权限验证装饰器
```python
# ✅ 正确示例 - 权限验证装饰器
def require_permission(permission: str):
    """权限验证装饰器"""
    def decorator(func):
        @wraps(func)
        async def wrapper(*args, **kwargs):
            # 从依赖注入获取当前用户上下文
            current_user = None
            for key, value in kwargs.items():
                if isinstance(value, UserContext):
                    current_user = value
                    break
            
            if not current_user:
                raise HTTPException(401, "缺少用户认证信息")
            
            if permission not in current_user.permissions:
                raise HTTPException(403, f"缺少权限: {permission}")
            
            return await func(*args, **kwargs)
        return wrapper
    return decorator

def require_role(role: str):
    """角色验证装饰器"""
    def decorator(func):
        @wraps(func)
        async def wrapper(*args, **kwargs):
            current_user = None
            for key, value in kwargs.items():
                if isinstance(value, UserContext):
                    current_user = value
                    break
            
            if not current_user:
                raise HTTPException(401, "缺少用户认证信息")
            
            if role not in current_user.roles:
                raise HTTPException(403, f"需要角色: {role}")
            
            return await func(*args, **kwargs)
        return wrapper
    return decorator

# 使用示例
@router.post("/visitors")
@require_permission("visitor:create")
async def create_visitor(
    visitor_data: VisitorCreateRequest,
    current_user: UserContext = Depends(get_current_user)
):

### 角色权限管理
```python
# ✅ 正确示例 - 角色权限领域模型
class Role:
    def __init__(self, name: str, permissions: List[str], tenant_id: str):
        self.name = self._validate_role_name(name)
        self.permissions = self._validate_permissions(permissions)
        self.tenant_id = tenant_id
        self.is_system_role = False
        self.created_at = datetime.utcnow()
    
    def add_permission(self, permission: str) -> None:
        """添加权限"""
        if self.is_system_role:
            raise DomainException("系统角色不能修改权限")
        
        if permission not in self.permissions:
            # 验证权限格式
            if not self._is_valid_permission_format(permission):
                raise DomainException(f"权限格式错误: {permission}")
            
            self.permissions.append(permission)
            self._add_domain_event(RolePermissionChangedEvent(
                role_name=self.name,
                tenant_id=self.tenant_id,
                permissions=self.permissions.copy()
            ))
    
    def remove_permission(self, permission: str) -> None:
        """移除权限"""
        if self.is_system_role:
            raise DomainException("系统角色不能修改权限")
        
        if permission in self.permissions:
            self.permissions.remove(permission)
            self._add_domain_event(RolePermissionChangedEvent(
                role_name=self.name,
                tenant_id=self.tenant_id,
                permissions=self.permissions.copy()
            ))
    
    def has_permission(self, permission: str) -> bool:
        """检查是否具有指定权限"""
        return permission in self.permissions
    
    def _validate_role_name(self, name: str) -> str:
        """验证角色名称"""
        if not name or not name.strip():
            raise DomainException("角色名称不能为空")
        
        clean_name = name.strip().lower()
        
        if len(clean_name) < 2:
            raise DomainException("角色名称长度不能少于2个字符")
        
        if len(clean_name) > 50:
            raise DomainException("角色名称长度不能超过50个字符")
        
        # 只允许字母、数字和下划线
        if not re.match(r"^[a-zA-Z0-9_]+$", clean_name):
            raise DomainException("角色名称只能包含字母、数字和下划线")
        
        return clean_name
    
    def _validate_permissions(self, permissions: List[str]) -> List[str]:
        """验证权限列表"""
        if not permissions:
            return []
        
        valid_permissions = []
        for permission in permissions:
            if self._is_valid_permission_format(permission):
                valid_permissions.append(permission)
            else:
                raise DomainException(f"权限格式错误: {permission}")
        
        return list(set(valid_permissions))  # 去重
    
    def _is_valid_permission_format(self, permission: str) -> bool:
        """验证权限格式: resource:action"""
        if not permission or ":" not in permission:
            return False
        
        parts = permission.split(":")
        return len(parts) == 2 and all(part.strip() for part in parts)

# 预定义系统角色
SYSTEM_ROLES = {
    "super_admin": Role(
        name="super_admin",
        permissions=[
            "visitor:read", "visitor:create", "visitor:update", "visitor:delete", "visitor:approve",
            "employee:read", "employee:create", "employee:update", "employee:delete",
            "department:read", "department:create", "department:update", "department:delete",
            "site:read", "site:create", "site:update", "site:delete",
            "user:read", "user:create", "user:update", "user:delete",
            "role:read", "role:create", "role:update", "role:delete",
            "system:admin", "tenant:admin"
        ],
        tenant_id="system"
    ),
    "admin": Role(
        name="admin",
        permissions=[
            "visitor:read", "visitor:create", "visitor:update", "visitor:approve",
            "employee:read", "employee:create", "employee:update",
            "department:read", "department:create", "department:update",
            "site:read"
        ],
        tenant_id="system"
    ),
    "user": Role(
        name="user",
        permissions=[
            "visitor:read", "visitor:create"
        ],
        tenant_id="system"
    )
}

# 标记为系统角色
for role in SYSTEM_ROLES.values():
    role.is_system_role = True

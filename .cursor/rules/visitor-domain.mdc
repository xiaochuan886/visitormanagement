## 二维码系统

### 二维码生成规则
```python
# ✅ 正确示例 - 二维码生成领域逻辑
import qrcode
import uuid
from datetime import datetime, timedelta

class QRCodeGenerator:
    @staticmethod
    def generate_visitor_qr_code(visitor: Visitor) -> str:
        """为已审批访客生成二维码"""
        if visitor.status != VisitorStatus.APPROVED:
            raise DomainException("只有已审批的访客才能生成二维码")
        
        # 生成唯一二维码内容
        qr_data = {
            "visitor_id": visitor.id,
            "tenant_id": visitor.tenant_id,
            "name": visitor.name,
            "company": visitor.company,
            "visit_date": visitor.visit_date.isoformat(),
            "expires_at": (datetime.utcnow() + timedelta(hours=24)).isoformat(),
            "token": str(uuid.uuid4())  # 防伪令牌
        }
        
        # 生成二维码图片
        qr = qrcode.QRCode(
            version=1,
            error_correction=qrcode.constants.ERROR_CORRECT_M,
            box_size=10,
            border=4,
        )
        qr.add_data(json.dumps(qr_data))
        qr.make(fit=True)
        
        # 转换为Base64字符串
        img = qr.make_image(fill_color="black", back_color="white")
        buffer = BytesIO()
        img.save(buffer, format="PNG")
        qr_code_base64 = base64.b64encode(buffer.getvalue()).decode()
        
        return qr_code_base64
    
    @staticmethod
    def verify_qr_code(qr_data: str, tenant_id: str) -> dict:
        """验证二维码有效性"""
        try:
            data = json.loads(qr_data)
            
            # 验证租户隔离
            if data.get("tenant_id") != tenant_id:
                raise DomainException("二维码租户不匹配")
            
            # 验证过期时间
            expires_at = datetime.fromisoformat(data["expires_at"])
            if expires_at < datetime.utcnow():
                raise DomainException("二维码已过期")
            
            # 验证访问日期
            visit_date = date.fromisoformat(data["visit_date"])
            if visit_date != date.today():
                raise DomainException("二维码不在有效访问日期")
            
            return data
            
        except (json.JSONDecodeError, KeyError, ValueError) as e:
            raise DomainException(f"二维码格式错误: {str(e)}")
```

### 访客验证流程
```python
# ✅ 正确示例 - 访客验证应用服务
class VisitorCheckInService:
    def __init__(self, visitor_repo: VisitorRepository, qr_service: QRCodeService):
        self._visitor_repo = visitor_repo
        self._qr_service = qr_service
    
    async def check_in_by_qr_code(
        self, 
        qr_data: str, 
        tenant_id: str, 
        device_id: str
    ) -> VisitorDto:
        """通过二维码签到"""
        # 1. 验证二维码
        qr_info = self._qr_service.verify_qr_code(qr_data, tenant_id)
        
        # 2. 获取访客实体
        visitor = await self._visitor_repo.get_by_id(qr_info["visitor_id"], tenant_id)
        if not visitor:
            raise VisitorNotFound("访客不存在")
        
        # 3. 执行签到业务逻辑
        visitor.check_in(device_id)
        
        # 4. 持久化变更
        await self._visitor_repo.save(visitor)
        
        # 5. 记录设备事件
        await self._device_service.record_check_in_event(device_id, visitor.id)
        
        return VisitorDto.from_entity(visitor)
```

## 访客数据验证

### 字段验证规则
```python
# ✅ 正确示例 - 完整的字段验证
class Visitor:
    def _validate_name(self, name: str) -> str:
        """验证访客姓名"""
        if not name or not name.strip():
            raise DomainException("访客姓名不能为空")
        
        clean_name = name.strip()
        if len(clean_name) < 2:
            raise DomainException("访客姓名长度不能少于2个字符")
        
        if len(clean_name) > 50:
            raise DomainException("访客姓名长度不能超过50个字符")
        
        # 只允许中文、英文字母和空格
        if not re.match(r"^[\u4e00-\u9fa5a-zA-Z\s]+$", clean_name):
            raise DomainException("访客姓名只能包含中文、英文字母和空格")
        
        return clean_name
    
    def _validate_phone(self, phone: str) -> str:
        """验证手机号码"""
        if not phone or not phone.strip():
            raise DomainException("手机号码不能为空")
        
        clean_phone = phone.strip()
        
        # 中国大陆手机号验证
        if not re.match(r"^1[3-9]\d{9}$", clean_phone):
            raise DomainException("请输入有效的中国大陆手机号码")
        
        return clean_phone
    
    def _validate_id_number(self, id_number: str) -> str:
        """验证身份证号"""
        if not id_number or not id_number.strip():
            raise DomainException("身份证号不能为空")
        
        clean_id = id_number.strip().upper()
        
        # 18位身份证验证
        if not re.match(r"^\d{17}[\dX]$", clean_id):
            raise DomainException("请输入有效的18位身份证号码")
        
        # 校验码验证
        if not self._validate_id_checksum(clean_id):
            raise DomainException("身份证号码校验位错误")
        
        return clean_id
    
    def _validate_license_plate(self, license_plate: Optional[str]) -> Optional[str]:
        """验证车牌号码"""
        if not license_plate:
            return None
        
        clean_plate = license_plate.strip().upper()
        
        # 中国车牌号验证
        pattern = r"^[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤青藏川宁琼使领A-Z]{1}[A-Z]{1}[A-Z0-9]{4}[A-Z0-9挂学警港澳]{1}$"
        if not re.match(pattern, clean_plate):
            raise DomainException("请输入有效的车牌号码")
        
        return clean_plate

    def _validate_id_checksum(self, id_number: str) -> bool:
        """验证身份证校验位"""
        weights = [7, 9, 10, 5, 8, 4, 2, 1, 6, 3, 7, 9, 10, 5, 8, 4, 2]
        check_codes = ['1', '0', 'X', '9', '8', '7', '6', '5', '4', '3', '2']
        
        sum_value = sum(int(id_number[i]) * weights[i] for i in range(17))
        check_index = sum_value % 11
        
        return id_number[17] == check_codes[check_index]
```

## 访客搜索和过滤

### 查询构建器模式
```python
# ✅ 正确示例 - 访客查询构建器
class VisitorQueryBuilder:
    def __init__(self):
        self._filters = []
        self._tenant_id = None
    
    def with_tenant(self, tenant_id: str) -> "VisitorQueryBuilder":
        """添加租户过滤（必需）"""
        self._tenant_id = tenant_id
        return self
    
    def with_status(self, status: VisitorStatus) -> "VisitorQueryBuilder":
        """按状态过滤"""
        self._filters.append(Visitor.status == status)
        return self
    
    def with_date_range(self, start_date: date, end_date: date) -> "VisitorQueryBuilder":
        """按访问日期范围过滤"""
        self._filters.append(Visitor.visit_date >= start_date)
        self._filters.append(Visitor.visit_date <= end_date)
        return self
    
    def with_company(self, company: str) -> "VisitorQueryBuilder":
        """按公司名称模糊搜索"""
        self._filters.append(Visitor.company.ilike(f"%{company}%"))
        return self
    
    def with_name(self, name: str) -> "VisitorQueryBuilder":
        """按访客姓名模糊搜索"""
        self._filters.append(Visitor.name.ilike(f"%{name}%"))
        return self
    
    def build(self) -> Query:
        """构建查询"""
        if not self._tenant_id:
            raise DomainException("查询必须包含租户ID")
        
        # 强制添加租户过滤
        self._filters.append(Visitor.tenant_id == self._tenant_id)
        
        return select(Visitor).where(and_(*self._filters))

# 使用示例
query = (VisitorQueryBuilder()
    .with_tenant(tenant_id)
    .with_status(VisitorStatus.APPROVED)
    .with_date_range(date.today(), date.today() + timedelta(days=7))
    .build())
```


# 访客管理领域 - Visitor Domain Rules

## 规则概述
本规则定义访客管理业务领域的核心逻辑、状态流转规则和二维码系统实现。适用于所有访客相关的业务功能开发，确保业务规则的一致性和完整性。

## 业务领域架构

### 核心实体文件
- **访客实体**: [entities/visitor.py](mdc:backend_service/app/domain/entities/visitor.py) - 访客领域实体
- **业务枚举**: [enums.py](mdc:backend_service/app/domain/enums.py) - 访客状态和业务枚举
- **领域事件**: [events/](mdc:backend_service/app/domain/events) - 访客相关的领域事件
- **访客路由**: [routes/visitors.py](mdc:backend_service/app/api/routes/visitors.py) - 访客API接口

## 访客状态管理

### 状态流转规则
```python
# 访客状态枚举定义
class VisitorStatus(str, Enum):
    PENDING = "pending"           # 待审批
    APPROVED = "approved"         # 已审批
    CHECKED_IN = "checked_in"     # 已签到
    CHECKED_OUT = "checked_out"   # 已签出
    CANCELLED = "cancelled"       # 已取消
    EXPIRED = "expired"           # 已过期
    REJECTED = "rejected"         # 已拒绝

# 状态流转矩阵 (from_status -> allowed_to_status)
VISITOR_STATUS_TRANSITIONS = {
    VisitorStatus.PENDING: [
        VisitorStatus.APPROVED,
        VisitorStatus.REJECTED,
        VisitorStatus.CANCELLED
    ],
    VisitorStatus.APPROVED: [
        VisitorStatus.CHECKED_IN,
        VisitorStatus.CANCELLED,
        VisitorStatus.EXPIRED
    ],
    VisitorStatus.CHECKED_IN: [
        VisitorStatus.CHECKED_OUT
    ],
    VisitorStatus.CHECKED_OUT: [],  # 终态
    VisitorStatus.CANCELLED: [],    # 终态
    VisitorStatus.EXPIRED: [],      # 终态
    VisitorStatus.REJECTED: []      # 终态
}
```

### 状态变更业务逻辑
```python
# ✅ 正确示例 - 状态变更领域方法
class Visitor:
    def __init__(self, name: str, phone: str, company: str, visit_date: date):
        self.name = self._validate_name(name)
        self.phone = self._validate_phone(phone)
        self.company = company
        self.visit_date = visit_date
        self.status = VisitorStatus.PENDING
        self.created_at = datetime.utcnow()
        self.qr_code = None
        self.approval_notes = None
    
    def approve(self, approval_notes: Optional[str] = None) -> None:
        """审批访客申请"""
        if self.status != VisitorStatus.PENDING:
            raise DomainException(f"只有待审批状态的访客才能被审批，当前状态: {self.status}")
        
        if self.visit_date < date.today():
            raise DomainException("不能审批已过期的访客申请")
        
        self.status = VisitorStatus.APPROVED
        self.approval_notes = approval_notes
        self.approved_at = datetime.utcnow()
        
        # 触发领域事件
        self._add_domain_event(VisitorApprovedEvent(visitor_id=self.id))
    
    def reject(self, rejection_reason: str) -> None:
        """拒绝访客申请"""
        if self.status != VisitorStatus.PENDING:
            raise DomainException(f"只有待审批状态的访客才能被拒绝，当前状态: {self.status}")
        
        if not rejection_reason or len(rejection_reason.strip()) < 5:
            raise DomainException("拒绝原因不能少于5个字符")
        
        self.status = VisitorStatus.REJECTED
        self.rejection_reason = rejection_reason.strip()
        self.rejected_at = datetime.utcnow()
        
        # 触发领域事件
        self._add_domain_event(VisitorRejectedEvent(visitor_id=self.id, reason=rejection_reason))
    
    def check_in(self, device_id: Optional[str] = None) -> None:
        """访客签到"""
        if self.status != VisitorStatus.APPROVED:
            raise DomainException(f"只有已审批的访客才能签到，当前状态: {self.status}")
        
        if self.visit_date != date.today():
            raise DomainException("只能在访问日期当天签到")
        
        self.status = VisitorStatus.CHECKED_IN
        self.checked_in_at = datetime.utcnow()
        self.check_in_device = device_id
        
        # 触发领域事件
        self._add_domain_event(VisitorCheckedInEvent(visitor_id=self.id, device_id=device_id))
    
    def check_out(self, device_id: Optional[str] = None) -> None:
        """访客签出"""
        if self.status != VisitorStatus.CHECKED_IN:
            raise DomainException(f"只有已签到的访客才能签出，当前状态: {self.status}")
        
        visit_duration = datetime.utcnow() - self.checked_in_at
        if visit_duration.total_seconds() < 60:  # 最少访问1分钟
            raise DomainException("访问时长不能少于1分钟")
        
        self.status = VisitorStatus.CHECKED_OUT
        self.checked_out_at = datetime.utcnow()
        self.check_out_device = device_id
        self.visit_duration = visit_duration
        
        # 触发领域事件
        self._add_domain_event(VisitorCheckedOutEvent(visitor_id=self.id, duration=visit_duration))

# ❌ 错误示例 - 在API层直接修改状态
@router.post("/visitors/{visitor_id}/approve")
async def approve_visitor(visitor_id: int):

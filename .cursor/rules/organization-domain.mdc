## 部门管理

### 部门领域模型
```python
# ✅ 正确示例 - 部门领域实体
class Department:
    def __init__(
        self,
        name: str,
        code: str,
        description: str,
        tenant_id: str,
        parent_id: Optional[int] = None
    ):
        self.name = self._validate_name(name)
        self.code = self._validate_code(code)
        self.description = description
        self.tenant_id = tenant_id
        self.parent_id = parent_id
        self.is_active = True
        self.created_at = datetime.utcnow()
        self.employee_count = 0
        self.children = []
    
    def add_child_department(self, child_department: "Department") -> None:
        """添加子部门"""
        if child_department.tenant_id != self.tenant_id:
            raise DomainException("子部门必须属于同一租户")
        
        if child_department.id == self.id:
            raise DomainException("部门不能成为自己的子部门")
        
        # 检查是否会形成循环层次关系
        if self._would_create_hierarchy_cycle(child_department):
            raise DomainException("添加子部门会形成循环层次关系")
        
        child_department.parent_id = self.id
        self.children.append(child_department)
        
        self._add_domain_event(DepartmentHierarchyChangedEvent(
            department_id=child_department.id,
            tenant_id=self.tenant_id,
            old_parent_id=None,
            new_parent_id=self.id
        ))
    
    def remove_child_department(self, child_department: "Department") -> None:
        """移除子部门"""
        if child_department in self.children:
            child_department.parent_id = None
            self.children.remove(child_department)
            
            self._add_domain_event(DepartmentHierarchyChangedEvent(
                department_id=child_department.id,
                tenant_id=self.tenant_id,
                old_parent_id=self.id,
                new_parent_id=None
            ))
    
    def move_to_parent(self, new_parent: Optional["Department"]) -> None:
        """移动到新的父部门"""
        if new_parent and new_parent.tenant_id != self.tenant_id:
            raise DomainException("新父部门必须属于同一租户")
        
        if new_parent and new_parent.id == self.id:
            raise DomainException("部门不能成为自己的父部门")
        
        if new_parent and self._would_create_hierarchy_cycle(new_parent):
            raise DomainException("移动部门会形成循环层次关系")
        
        old_parent_id = self.parent_id
        new_parent_id = new_parent.id if new_parent else None
        
        self.parent_id = new_parent_id
        
        self._add_domain_event(DepartmentHierarchyChangedEvent(
            department_id=self.id,
            tenant_id=self.tenant_id,
            old_parent_id=old_parent_id,
            new_parent_id=new_parent_id
        ))
    
    def deactivate(self) -> None:
        """停用部门"""
        if not self.is_active:
            raise DomainException("部门已经是停用状态")
        
        # 检查是否有员工
        if self.employee_count > 0:
            raise DomainException("有员工的部门不能被停用，请先转移员工")
        
        # 检查是否有子部门
        if self.children:
            raise DomainException("有子部门的部门不能被停用，请先处理子部门")
        
        self.is_active = False
        self.deactivated_at = datetime.utcnow()
        
        self._add_domain_event(DepartmentDeactivatedEvent(
            department_id=self.id,
            tenant_id=self.tenant_id
        ))
    
    def update_employee_count(self, count: int) -> None:
        """更新员工数量"""
        if count < 0:
            raise DomainException("员工数量不能为负数")
        
        self.employee_count = count
    
    def get_hierarchy_path(self) -> List[str]:
        """获取部门层次路径"""
        path = [self.name]
        current = self
        
        while current.parent_id:
            # 这里需要通过仓储获取父部门
            # parent = await department_repository.get_by_id(current.parent_id)
            # if parent:
            #     path.insert(0, parent.name)
            #     current = parent
            # else:
            #     break
            pass
        
        return path
    
    def _would_create_hierarchy_cycle(self, potential_parent: "Department") -> bool:
        """检查是否会创建循环层次关系"""
        visited = set()
        current = potential_parent
        
        while current and current.parent_id:
            if current.parent_id in visited:
                return True  # 已存在循环
            
            if current.parent_id == self.id:
                return True  # 会创建新循环
            
            visited.add(current.parent_id)
            # 这里需要通过仓储获取父部门
            # current = await department_repository.get_by_id(current.parent_id)
        
        return False
    
    def _validate_name(self, name: str) -> str:
        """验证部门名称"""
        if not name or not name.strip():
            raise DomainException("部门名称不能为空")
        
        clean_name = name.strip()
        if len(clean_name) < 2:
            raise DomainException("部门名称长度不能少于2个字符")
        
        if len(clean_name) > 100:
            raise DomainException("部门名称长度不能超过100个字符")
        
        return clean_name
    
    def _validate_code(self, code: str) -> str:
        """验证部门代码"""
        if not code or not code.strip():
            raise DomainException("部门代码不能为空")
        
        clean_code = code.strip().upper()
        if len(clean_code) < 2:
            raise DomainException("部门代码长度不能少于2个字符")
        
        if len(clean_code) > 20:
            raise DomainException("部门代码长度不能超过20个字符")
        
        # 只允许字母和数字
        if not re.match(r"^[A-Z0-9]+$", clean_code):
            raise DomainException("部门代码只能包含大写字母和数字")
        
        return clean_code

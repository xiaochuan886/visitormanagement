### 员工查询构建器
```python
# ✅ 正确示例 - 员工查询构建器
class EmployeeQueryBuilder:
    def __init__(self):
        self._filters = []
        self._tenant_id = None
    
    def with_tenant(self, tenant_id: str) -> "EmployeeQueryBuilder":
        """添加租户过滤（必需）"""
        self._tenant_id = tenant_id
        return self
    
    def with_department(self, department_id: int) -> "EmployeeQueryBuilder":
        """按部门过滤"""
        self._filters.append(Employee.department_id == department_id)
        return self
    
    def with_manager(self, manager_id: int) -> "EmployeeQueryBuilder":
        """按直属上级过滤"""
        self._filters.append(Employee.manager_id == manager_id)
        return self
    
    def with_position(self, position: str) -> "EmployeeQueryBuilder":
        """按职位模糊搜索"""
        self._filters.append(Employee.position.ilike(f"%{position}%"))
        return self
    
    def with_name(self, name: str) -> "EmployeeQueryBuilder":
        """按姓名模糊搜索"""
        self._filters.append(Employee.name.ilike(f"%{name}%"))
        return self
    
    def with_active_status(self, is_active: bool = True) -> "EmployeeQueryBuilder":
        """按激活状态过滤"""
        self._filters.append(Employee.is_active == is_active)
        return self
    
    def build(self) -> Query:
        """构建查询"""
        if not self._tenant_id:
            raise DomainException("查询必须包含租户ID")
        
        # 强制添加租户过滤
        self._filters.append(Employee.tenant_id == self._tenant_id)
        
        return select(Employee).where(and_(*self._filters))

## 站点管理

### 站点领域模型
```python
# ✅ 正确示例 - 站点领域实体
class Site:
    def __init__(
        self,
        name: str,
        code: str,
        address: str,
        tenant_id: str
    ):
        self.name = self._validate_name(name)
        self.code = self._validate_code(code)
        self.address = self._validate_address(address)
        self.tenant_id = tenant_id
        self.is_active = True
        self.created_at = datetime.utcnow()
        self.latitude = None
        self.longitude = None
        self.contact_person = None
        self.contact_phone = None
    
    def update_location(self, latitude: float, longitude: float) -> None:
        """更新地理位置"""
        if not (-90 <= latitude <= 90):
            raise DomainException("纬度必须在-90到90之间")
        
        if not (-180 <= longitude <= 180):
            raise DomainException("经度必须在-180到180之间")
        
        self.latitude = latitude
        self.longitude = longitude
        
        self._add_domain_event(SiteLocationUpdatedEvent(
            site_id=self.id,
            tenant_id=self.tenant_id,
            latitude=latitude,
            longitude=longitude
        ))
    
    def update_contact(self, contact_person: str, contact_phone: str) -> None:
        """更新联系信息"""
        self.contact_person = self._validate_contact_person(contact_person)
        self.contact_phone = self._validate_contact_phone(contact_phone)
        
        self._add_domain_event(SiteContactUpdatedEvent(
            site_id=self.id,
            tenant_id=self.tenant_id,
            contact_person=contact_person,
            contact_phone=contact_phone
        ))
    
    def deactivate(self) -> None:
        """停用站点"""
        if not self.is_active:
            raise DomainException("站点已经是停用状态")
        
        self.is_active = False
        self.deactivated_at = datetime.utcnow()
        
        self._add_domain_event(SiteDeactivatedEvent(
            site_id=self.id,
            tenant_id=self.tenant_id
        ))
    
    def _validate_name(self, name: str) -> str:
        """验证站点名称"""
        if not name or not name.strip():
            raise DomainException("站点名称不能为空")
        
        clean_name = name.strip()
        if len(clean_name) < 2:
            raise DomainException("站点名称长度不能少于2个字符")
        
        if len(clean_name) > 100:
            raise DomainException("站点名称长度不能超过100个字符")
        
        return clean_name
    
    def _validate_code(self, code: str) -> str:
        """验证站点代码"""
        if not code or not code.strip():
            raise DomainException("站点代码不能为空")
        
        clean_code = code.strip().upper()
        if len(clean_code) < 2:
            raise DomainException("站点代码长度不能少于2个字符")
        
        if len(clean_code) > 20:
            raise DomainException("站点代码长度不能超过20个字符")
        
        # 只允许字母和数字
        if not re.match(r"^[A-Z0-9]+$", clean_code):
            raise DomainException("站点代码只能包含大写字母和数字")
        
        return clean_code
    
    def _validate_address(self, address: str) -> str:
        """验证站点地址"""
        if not address or not address.strip():
            raise DomainException("站点地址不能为空")
        
        clean_address = address.strip()
        if len(clean_address) < 10:
            raise DomainException("站点地址长度不能少于10个字符")
        
        if len(clean_address) > 200:
            raise DomainException("站点地址长度不能超过200个字符")
        
        return clean_address
    
    def _validate_contact_person(self, contact_person: str) -> str:
        """验证联系人"""
        if not contact_person or not contact_person.strip():
            raise DomainException("联系人不能为空")
        
        clean_name = contact_person.strip()
        if len(clean_name) < 2:
            raise DomainException("联系人姓名长度不能少于2个字符")
        
        if len(clean_name) > 50:
            raise DomainException("联系人姓名长度不能超过50个字符")
        
        return clean_name
    
    def _validate_contact_phone(self, contact_phone: str) -> str:
        """验证联系电话"""
        if not contact_phone or not contact_phone.strip():
            raise DomainException("联系电话不能为空")
        
        clean_phone = contact_phone.strip()
        
        # 支持手机号和固定电话
        mobile_pattern = r"^1[3-9]\d{9}$"
        landline_pattern = r"^0\d{2,3}-?\d{7,8}$"
        
        if not (re.match(mobile_pattern, clean_phone) or re.match(landline_pattern, clean_phone)):
            raise DomainException("请输入有效的手机号码或固定电话")
        
        return clean_phone
```

